# Dependencies
node_modules/

# Build output
dist/
dist-electron/
out/
release/

# Local database — never commit real flight data
*.db
*.db-journal
*.db-wal
*.db-shm
!seed/*.db

# Raw flight captures (scripts/spike-capture-flight.ts) — real coordinates/times, stays
# local per CLAUDE.md's Security section. A trimmed/anonymized fixture derived from one is
# what lands in the test suite, not the raw capture itself.
flight-captures/

# Personal data exports (e.g. a logbook CSV for testing the CSV importer) — never commit
# real flight history. Add a !path exception if a data file genuinely needs vendoring.
*.csv
!resources/*.csv

# Env / secrets
.env
.env.local
*.local
*.local.md

# Logs
*.log
npm-debug.log*
logs/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Vitest / coverage
coverage/

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# TypeScript incremental build info
*.tsbuildinfo

# Kept local-only on purpose — not for the public repo (see docs/decisions.md)
docs/future-monetization.md
