{
  "name": "winglog",
  "version": "1.5.4",
  "description": "Local-first fleet, dispatch, tracking and logbook companion for MSFS 2024.",
  "private": true,
  "author": "Callum Jones",
  "license": "GPL-3.0-only",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && npm run build:lan",
    "build:lan": "vite build --config vite.lan.config.ts",
    "preview": "electron-vite preview",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run",
    "test:watch": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs",
    "test:coverage": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run --coverage",
    "test:e2e": "npm run build && playwright test",
    "lint": "eslint . && prettier --check .",
    "lint:report": "eslint . -f json -o release/lint/eslint.json && tsx scripts/lint-report.ts",
    "dup": "jscpd src --threshold 0.3 --min-lines 8 --min-tokens 70 --ignore \"**/*.test.ts,**/*.test.tsx,**/components/ui/**,**/locales/**,**/__fixtures__/**\" --reporters console,json --output release/jscpd --silent",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p e2e/tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/tsx/dist/cli.mjs scripts/db-migrate.ts",
    "db:backfill-operator-icao": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/tsx/dist/cli.mjs scripts/backfill-operator-icao.ts",
    "db:backfill-aircraft-photos": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/tsx/dist/cli.mjs scripts/backfill-aircraft-photos.ts",
    "fixture:from-capture": "tsx scripts/fixture-from-capture.ts",
    "sim": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run --config scripts/sim/vitest.config.ts",
    "spike:simconnect": "tsx scripts/spike-simconnect.ts",
    "spike:landing": "tsx scripts/spike-landing.ts",
    "spike:altitude": "tsx scripts/spike-altitude.ts",
    "logo-health": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/tsx/dist/cli.mjs --tsconfig tsconfig.node.json scripts/logo-health.ts",
    "spike:runway-thresholds": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/tsx/dist/cli.mjs --tsconfig tsconfig.node.json scripts/spike-runway-thresholds.ts",
    "spike:airac": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/tsx/dist/cli.mjs --tsconfig tsconfig.node.json scripts/spike-airac-refresh.ts",
    "spike:live-position": "tsx scripts/spike-live-position.ts",
    "spike:facilities": "tsx scripts/spike-facilities.ts",
    "spike:taxi-data": "tsx scripts/spike-taxi-data.ts",
    "spike:airport-list": "tsx scripts/spike-airport-list.ts",
    "spike:landing-rate": "tsx scripts/spike-landing-rate.ts",
    "spike:capture-flight": "tsx scripts/spike-capture-flight.ts",
    "spike:gsx-remote": "tsx scripts/spike-gsx-remote.ts",
    "spike:gsx-remote-listen": "tsx scripts/spike-gsx-remote-listen.ts",
    "spike:navdata-provider": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/tsx/dist/cli.mjs scripts/spike-navdata-provider.ts",
    "spike:route-simplify": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/tsx/dist/cli.mjs scripts/spike-route-simplify.ts",
    "vendor:runways": "tsx scripts/vendor-runways.ts",
    "perf:tabs": "tsx --tsconfig tsconfig.node.json e2e/tab-timing.perf.ts",
    "perf:profile": "tsx --tsconfig tsconfig.node.json e2e/tab-profile.perf.ts",
    "test:airports": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run --config scripts/sim/vitest.config.ts airports",
    "cache:airports": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/tsx/dist/cli.mjs --tsconfig tsconfig.node.json scripts/cache-airports.ts",
    "atc-corpus": "tsx --tsconfig tsconfig.node.json scripts/atc-corpus.ts",
    "licenses:generate": "tsx scripts/generate-third-party-licenses.ts",
    "package": "electron-vite build && npm run build:lan && electron-builder --publish=never",
    "sim:second-screen": "electron-vite build && npm run build:lan && playwright test -c playwright.screenshots.config.ts e2e/second-screen-flight.shots.ts",
    "sim:screens": "electron-vite build && playwright test -c playwright.screenshots.config.ts e2e/flight-sim.shots.ts",
    "manual:screenshots": "electron-vite build && playwright test -c playwright.screenshots.config.ts",
    "manual:build": "esbuild scripts/manual/build.ts --bundle --platform=node --format=cjs --external:electron --outfile=out-manual/build.cjs --log-level=warning && electron out-manual/build.cjs",
    "package:win": "npm run manual:build && electron-vite build && npm run build:lan && electron-builder --win --publish=never",
    "package:win:dev": "npm run manual:build && cross-env WINGLOG_DEV_BUILD=1 electron-vite build && npm run build:lan && electron-builder --win --publish=never \"-c.win.artifactName=${productName}-Dev-${version}-win-${arch}.${ext}\"",
    "package:mac": "electron-vite build && npm run build:lan && electron-builder --mac --publish=never",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "electron-log": "^5.4.4",
    "electron-updater": "6.8.11",
    "i18next": "26.5.4",
    "lucide-react": "1.61.0",
    "maplibre-gl": "^6.15.0",
    "next-themes": "^0.4.6",
    "node-simconnect": "4.2.1",
    "qrcode-generator": "2.0.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^17.1.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.0.5",
    "cross-env": "10.1.0",
    "drizzle-kit": "0.31.11",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "65.4.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jscpd": "5.4.2",
    "jsdom": "^30.1.3",
    "jsqr": "1.4.0",
    "marked": "18.1.1",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "overrides": {
    "esbuild": ">=0.25.0"
  }
}
